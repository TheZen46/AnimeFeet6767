% Aliases-ish
\newcommand{\R}{\mathbb R}
\newcommand{\C}{\mathbb C}
\newcommand{\N}{\mathbb N}
\newcommand{\mb}{\mathbb}
\newcommand{\mc}{\mathcal}
\newcommand{\hx}{\hat x}
\newcommand{\hy}{\hat y}
\newcommand{\hz}{\hat z}
\newcommand{\deleps}{\delta_\epsilon}
\renewcommand{\phi}{\varphi}
\renewcommand{\epsilon}{\varepsilon}
\newcommand{\atan}{\operatorname{atan}}
\newcommand{\roots}{\operatorname{roots}}
\newcommand{\m}[1]{\mskip{#1mu}}
\newcommand{\ds}{\displaystyle}

\renewcommand{\lt}[1]{\mathcal{L}\Bigl\{#1\Bigr\}}        % Laplace Transform
\newcommand{\ilt}[1]{\mathcal{L}^{-1}\Bigl\{#1\Bigr\}}    % Inverse Laplace Transform
\renewcommand{\array}[1]{\begin{array}{l}#1\end{array}}
\renewcommand{\cases}[1]{\begin{cases}{l}#1\end{cases}}
\renewcommand{\pmatrix}[1]{\left(\begin{array}{c}#1\end{array}\right)}
\newcommand{\suml}{\sum\limits}
\newcommand{\limit}{\lim\limits}
\newcommand{\abs}[1]{\left\vert#1\right\vert}
\newcommand{\norm}[1]{\left\Vert#1\right\Vert}

\newcommand{\defR}[2]{:#1\subset\mathbb R^#2\to \mathbb R}
\newcommand{\defC}[2]{:#1\subset\mathbb C^#2\to \mathbb C}
\newcommand{\defRC}[2]{:#1\subset\mathbb R^#2\to \mathbb C}
\newcommand{\defCR}[2]{:#1\subset\mathbb C^#2\to \mathbb R}